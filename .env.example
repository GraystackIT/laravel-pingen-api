# OAuth client of your Pingen account (client_credentials grant).
PINGEN_CLIENT_ID=
PINGEN_CLIENT_SECRET=

# The organisation every request is scoped to, as a UUID.
PINGEN_ORGANISATION_ID=

# Point everything at the staging environment while you integrate.
PINGEN_STAGING=true

# Shared secret of the webhook you registered. Empty disables verification,
# which is only ever appropriate on a local machine.
PINGEN_WEBHOOK_SIGNING_KEY=
